# Optional overrides — connectwise-asio-mcp has no required env vars.
# Authentication is per-request via the X-ConnectWise-Asio-Token request
# header: a bearer access token obtained via OAuth2 Client Credentials
# (POST https://openapi.service.itsupport247.net/v1/token with client_id +
# client_secret + scope). This server never sees the client_id/client_secret
# — the caller (Agent Platform / upstream gateway) obtains and refreshes the
# token, and only the resulting bearer token is forwarded here.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# ConnectWise Asio has 3 regional servers. The first few characters of the
# Client ID indicate the region (0e30=NA, 0e31=EU, 0e32=AU). Set a default
# here, or override per-request with the X-ConnectWise-Asio-Base-Url header.
# CONNECTWISE_ASIO_BASE_URL=https://openapi.service.itsupport247.net
